# =========================================
# PROTEGER-NR1 EPT — Backend (.env.example)
# =========================================

# --- Bancos de dados (3 separados: anonimato, auth, memória institucional) ---
# Em desenvolvimento local (via devcontainer), aponta para o Postgres do docker-compose.
# Em produção, cada um aponta para um projeto Neon Postgres distinto.
DATABASE_URL_ANONIMO=postgresql://devuser:devpass@db:5432/anonimo_db
DATABASE_URL_AUTH=postgresql://devuser:devpass@db:5432/auth_db
DATABASE_URL_MEMORIA=postgresql://devuser:devpass@db:5432/memoria_db

# --- Segurança ---
SECRET_KEY=troque-esta-chave-em-producao

# --- Bootstrap do primeiro Administrador (usado apenas no primeiro deploy) ---
ADMIN_BOOTSTRAP_EMAIL=admin@exemplo.com
ADMIN_BOOTSTRAP_PASSWORD=troque-esta-senha

# --- k-anonimato (padrão configurável depois via painel do Administrador) ---
K_ANONIMATO_THRESHOLD_DEFAULT=5

# --- Integração com LLM (opcional, desativado por padrão) ---
# Provedores suportados via formato compatível com OpenAI: anthropic, openai, gemini,
# openrouter, nvidia_build
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=

# --- CORS (domínio do frontend, separado por vírgula se houver mais de um) ---
CORS_ORIGINS=http://localhost:5173

# --- Ambiente ---
FLASK_ENV=development
FLASK_DEBUG=true
